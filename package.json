    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.4.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
